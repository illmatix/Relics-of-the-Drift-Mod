<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>DriftRelics.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <!--
    Pure-logic source files are included here directly so the test
    runtime never loads the VS DLLs. As each pure module is added
    to src/, add it to this Compile Include list.
  -->
  <ItemGroup>
    <Compile Include="../../src/Api/RelicSlotType.cs" Link="Api/RelicSlotType.cs" />
    <Compile Include="../../src/Api/RelicInstance.cs" Link="Api/RelicInstance.cs" />
    <Compile Include="../../src/Api/IRelicItem.cs" Link="Api/IRelicItem.cs" />
    <Compile Include="../../src/Api/IAffixRegistry.cs" Link="Api/IAffixRegistry.cs" />
    <Compile Include="../../src/Modifier/ModifierOp.cs" Link="Modifier/ModifierOp.cs" />
    <Compile Include="../../src/Modifier/ModifierEntry.cs" Link="Modifier/ModifierEntry.cs" />
    <Compile Include="../../src/Affix/AffixKind.cs" Link="Affix/AffixKind.cs" />
    <Compile Include="../../src/Affix/Affix.cs" Link="Affix/Affix.cs" />
    <Compile Include="../../src/Affix/TierConfig.cs" Link="Affix/TierConfig.cs" />
    <Compile Include="../../src/Affix/SignatureAffix.cs" Link="Affix/SignatureAffix.cs" />
    <Compile Include="../../src/Affix/AffixConfig.cs" Link="Affix/AffixConfig.cs" />
    <Compile Include="../../src/Affix/ScrambleNameGenerator.cs" Link="Affix/ScrambleNameGenerator.cs" />
    <Compile Include="../../src/Affix/AffixRegistry.cs" Link="Affix/AffixRegistry.cs" />
    <Compile Include="../../src/Affix/AffixPool.cs" Link="Affix/AffixPool.cs" />
    <Compile Include="../../src/Affix/AffixConfigLoader.cs" Link="Affix/AffixConfigLoader.cs" />
    <Compile Include="../../src/Affix/TierRoller.cs" Link="Affix/TierRoller.cs" />
  </ItemGroup>

  <!--
    Temporary exclusions during the affix-rarity-tiers schema transition.
    BaubleRollerTests references AffixPool / RelicRoller; AffixConfigLoaderTests
    references AffixConfigLoader. Both are reintroduced by Tasks 5 and 7 of the
    rarity-tiers plan, at which point the source files compile cleanly again.
    Remove these Compile Remove entries once those tasks land.
  -->
  <ItemGroup>
    <Compile Remove="BaubleRollerTests.cs" />
  </ItemGroup>

</Project>
